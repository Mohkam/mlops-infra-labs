FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    feast==0.40.1 \
    "feast[cassandra]" \
    "feast[redis]" \
    pandas \
    pyarrow \
    numpy

WORKDIR /workspace
